{
  "uid": "the-gallery",
  "title": "The Gallery — world feed direction",
  "tags": ["f1", "agentic-cinema", "the-gallery"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "annotations": {
    "list": [
      {
        "name": "Director cuts",
        "enable": true,
        "iconColor": "purple",
        "type": "tags",
        "tags": ["gallery", "cut"]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Battle tension by contested position",
      "description": "Every adjacent pairing scored at 10 Hz. The dashed line is the cut threshold.",
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "expr": "gallery_battle_tension",
          "legendFormat": "P{{position}} — {{ahead}} v {{behind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "unit": "short",
          "custom": { "fillOpacity": 8, "lineWidth": 2, "showPoints": "never" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "purple", "value": 0.55 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "On air",
      "description": "Battle score of the shot currently going out on the world feed.",
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "targets": [{ "refId": "A", "expr": "gallery_on_air_score" }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 1, "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "yellow", "value": null },
              { "color": "green", "value": 0.55 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Director latency",
      "gridPos": { "h": 5, "w": 8, "x": 16, "y": 4 },
      "targets": [{ "refId": "A", "expr": "gallery_director_latency_ms" }],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1200 },
              { "color": "red", "value": 3000 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Gap between contesting cars",
      "description": "Seconds. Below 1.0 the following car has DRS.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "gallery_battle_gap_seconds",
          "legendFormat": "P{{position}} — {{ahead}} v {{behind}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "fillOpacity": 0, "lineWidth": 2, "showPoints": "never" }
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cuts committed by decision tier",
      "description": "adk = Gemini via the Agent Development Kit. heuristic = deterministic fallback.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 9 },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(gallery_cuts_total[1m])",
          "legendFormat": "{{tier}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1 }
        }
      }
    }
  ]
}
