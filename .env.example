# ---- Gemini / Google Cloud ---------------------------------------------------
# Either a Gemini API key...
GOOGLE_API_KEY=

# ...or Vertex AI on Google Cloud (set USE_VERTEX=1 and configure gcloud ADC)
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

DIRECTOR_MODEL=gemini-flash-lite-latest

# ---- Grafana (partner track) -------------------------------------------------
# Local:  http://localhost:3000  (see docker-compose.yml)
# Cloud:  https://<stack>.grafana.net
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=
GRAFANA_ORG_ID=1

# ---- Race replay -------------------------------------------------------------
RACE_YEAR=2023
RACE_EVENT=Monza
RACE_SESSION=R
REPLAY_SPEED=8.0
