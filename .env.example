# ---- Gemini / Google Cloud ---------------------------------------------------
# Either a Gemini API key...
GOOGLE_API_KEY=

# ...or Vertex AI on Google Cloud (set USE_VERTEX=1 and configure gcloud ADC)
GOOGLE_GENAI_USE_VERTEXAI=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

DIRECTOR_MODEL=gemini-flash-lite-latest

# ---- Grafana (partner track) -------------------------------------------------
# Local:  http://localhost:3000  (see docker-compose.yml)
# Cloud:  https://<stack>.grafana.net
GRAFANA_URL=http://localhost:3000
GRAFANA_TOKEN=
GRAFANA_ORG_ID=1

# ---- Race replay -------------------------------------------------------------
RACE_YEAR=2023
RACE_EVENT=Monza
RACE_SESSION=R
REPLAY_SPEED=8.0

# Prometheus remote_write, so the app pushes its own metrics to Grafana Cloud.
# Grafana Cloud cannot scrape a process it has no route to, and running a local
# Prometheus to forward means the graphs die when that machine does.
#   URL + USER: Grafana Cloud -> your stack -> Prometheus -> Send Metrics
#   TOKEN:      grafana.com -> Access Policies -> scope metrics:write
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_PROM_TOKEN=

# Public (no-login) dashboard share link, shown in the nav.
GRAFANA_PUBLIC_URL=

# Path to Grafana's MCP server binary. Bundled at /usr/local/bin in the
# container; set this when running locally.
#   https://github.com/grafana/mcp-grafana/releases
MCP_GRAFANA_BIN=
